# --- MCP resource server ---
MCP_NAME=pg_mcp_qauth
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Public base URL of this server; used in RFC 9728 protected-resource metadata.
# Behind a reverse proxy set the external URL clients can reach.
MCP_BASE_URL=http://localhost:8000
MCP_PATH=/mcp

# --- Authorization server (Keycloak / Authentik) ---
# Single issuer; multi-provider login is handled by the AS via identity brokering.
AUTH_ISSUER=https://keycloak.example.com/realms/myrealm
JWKS_URI=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/certs
# REQUIRED: restricts accepted tokens to those issued for this resource server
# (prevents token passthrough from other clients of the same issuer).
REQUIRED_AUDIENCE=pg-mcp
REQUIRED_SCOPE=
# Exactly ONE pinned asymmetric algorithm (RS*/ES*/PS*/EdDSA); HS*/none are rejected.
ALGORITHMS=RS256
# JWT claim holding the user's groups/roles, and the claim used for RLS identity.
ROLES_CLAIM=groups
RLS_USER_CLAIM=email

# --- group -> postgres role mapping (JSON) ---
# Precedence follows the DECLARATION ORDER of this object: the first key that
# matches one of the user's groups wins. Put higher-priority groups first.
# If nothing matches, DEFAULT_ROLE is used.
# NOTE (Keycloak): roles live under realm_access.roles / resource_access.<client>.roles.
# Configure a protocol mapper to emit a flat claim (e.g. "groups") that ROLES_CLAIM reads.
ROLE_MAP_JSON={"analysts":"read_analyst","marketing":"read_marketing"}
DEFAULT_ROLE=read_only

# --- Postgres ---
# PG_USER must NOT be a superuser or table owner, and must be a member of every
# target role (GRANT <role> TO <PG_USER>) so that SET LOCAL ROLE succeeds.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=analytics
PG_USER=mcp_gateway
PG_PASSWORD=change-me

# --- Limits / pool ---
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=30000
GRANT_CACHE_TTL=60
POOL_MIN=1
POOL_MAX=10
ALLOW_SYSTEM_SCHEMAS=false
